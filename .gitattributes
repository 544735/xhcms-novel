# 默认按文本处理并统一换行；Windows 脚本保留 CRLF，Shell 使用 LF
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.docx binary
*.pdf binary
*.db binary
*.sqlite binary

# 锁文件不做行级合并
pnpm-lock.yaml merge=binary

# 语言统计
screenshots/** linguist-documentation
docs/** linguist-documentation
