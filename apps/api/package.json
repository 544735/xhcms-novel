{
  "name": "@wmcms/api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset --skip-generate && prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "db:backfill-unlocks": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/backfill-unlock-snapshots.ts",
    "test": "jest --config test/jest-e2e.json --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:unit": "jest --config test/jest-unit.json --runInBand"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "@wmcms/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "iconv-lite": "^0.6.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  }
}
