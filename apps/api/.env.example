# ============================================================
# WMCMS 2.0 API 环境变量示例
# 复制为 .env 后按需修改。切勿把真实密钥提交到版本库！
#
# 生产环境必须显式提供以下密钥（缺失时应用会拒绝启动）：
#   JWT_SECRET、JWT_REFRESH_SECRET、JWT_MEMBER_SECRET
# 生成方式：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# 开发环境（NODE_ENV != production）不配置时，启动时自动生成进程内随机密钥，
# 重启后旧令牌失效 —— 这是预期行为。
# ============================================================

DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development

# 管理端访问令牌签名密钥（生产必填）
JWT_SECRET=""
# 管理端刷新令牌签名密钥（生产必填）
JWT_REFRESH_SECRET=""
# 门户会员令牌签名密钥（生产必填）
JWT_MEMBER_SECRET=""

# 允许的前端来源，逗号分隔
CORS_ORIGINS="http://localhost:3000"
UPLOAD_DIR="uploads"
# 门户前台对外访问地址（用于 sitemap.xml / rss.xml 中的绝对链接）
PUBLIC_BASE_URL="http://localhost:3000"
