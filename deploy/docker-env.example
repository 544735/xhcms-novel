# XHCMS Novel 2.0 Docker Compose 环境变量示例
# 使用：cp deploy/docker-env.example .env 后填写下面的密钥（可用下方命令生成）
#
# 生成随机密钥（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   openssl rand -hex 48

# 对外访问地址（门户/后台），域名部署时改为 https://your-domain.com
PUBLIC_URL=http://localhost:3000

# 宿主机端口映射
WEB_PORT=3000
API_PORT=4000

# 浏览器访问 API 的地址（构建期写入前端）
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# 三个 JWT 密钥（必填，生产环境务必使用随机值）
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_MEMBER_SECRET=

# 首次启动是否写入演示数据（1=写入，会初始化 7 本书 / 70 章；生产首次可设为 1 后改回 0）
SEED_DEMO=0
